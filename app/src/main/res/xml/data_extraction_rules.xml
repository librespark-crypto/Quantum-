<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ / API 31+ backup rules. Root element must be
    <data-extraction-rules>; the previous <data-extraction_rules> is not a valid
    element and made resource compilation fail.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="quantum-player-db" />
        <exclude domain="file" path="yt-dlp/" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="quantum-player-db" />
    </device-transfer>
</data-extraction-rules>
