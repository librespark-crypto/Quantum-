<resources>
    <!-- Base application theme. -->
    <style name="Theme.Quantum" parent="Theme.Material.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#0A0E17</item>
        <item name="colorPrimaryContainer">#1A1F2E</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#0066FF</item>
        <item name="colorSecondaryContainer">#0050C9</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <!-- Background colors -->
        <item name="android:colorBackground">#050810</item>
        <item name="colorSurface">#0A0E17</item>
        <item name="colorOnSurface">#E8E8E8</item>
        <!-- Error color -->
        <item name="colorError">#FF5252</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">#0A0E17</item>
        <item name="android:navigationBarColor">#0A0E17</item>
    </style>

    <!-- PiP theme -->
    <style name="Theme.Quantum.Pip" parent="Theme.Material.DayNight.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:disableAnimations">false</item>
    </style>

    <!-- No action bar -->
    <style name="Theme.Quantum.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Toolbar style -->
    <style name="Quantum.Toolbar" parent="Widget.Material.Toolbar">
        <item name="popupTheme">@style/Theme.Quantum.Popup</item>
    </style>

    <!-- Popup menu style -->
    <style name="Theme.Quantum.Popup" parent="Widget.Material.PopupMenu">
        <item name="android:background">#1A1F2E</item>
        <item name="android:itemTextColor">#E8E8E8</item>
    </style>

    <!-- Card view style -->
    <style name="Quantum.Card" parent="Widget.Material.CardView">
        <item name="cardBackgroundColor">#1A1F2E</item>
        <item name="cardCornerRadius">8dp</item>
    </style>

    <!-- Button style -->
    <style name="Quantum.Button" parent="Widget.Material.Button">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Text styles -->
    <style name="Quantum.Title1" parent="TextAppearance.Material3.Title1">
        <item name="android:textColor">#E8E8E8</item>
    </style>

    <style name="Quantum.Title2" parent="TextAppearance.Material3.Title2">
        <item name="android:textColor">#E8E8E8</item>
    </style>

    <style name="Quantum.Body1" parent="TextAppearance.Material3.Body1">
        <item name="android:textColor">#B0B0B0</item>
    </style>

    <style name="Quantum.Body2" parent="TextAppearance.Material3.Body2">
        <item name="android:textColor">#B0B0B0</item>
    </style>

    <style name="Quantum.Caption" parent="TextAppearance.Material3.Caption">
        <item name="android:textColor">#666666</item>
    </style>
</resources>